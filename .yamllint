---

# The lint configuration for this repository. A Helm template is not YAML
# until helm renders it, so this file excludes the templates. `helm lint` and
# the render-and-schema-check step in CI cover them instead.

extends: default

ignore: |
  charts/*/templates/

rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  # "on:" in a workflow file is a key, not a boolean
  truthy:
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: true
  document-start:
    present: true
  empty-lines:
    max: 2
